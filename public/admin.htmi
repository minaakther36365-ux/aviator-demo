<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin</title><script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script><style>*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}body{background:#0b0c15;color:#fff;padding:12px}.box{background:#1a1c28;border-radius:12px;padding:12px;border:1px solid #2a2c3d;margin-bottom:10px}table{width:100%;border-collapse:collapse;font-size:11px}th,td{padding:7px;border-bottom:1px solid #2a2c3d}input{width:100%;padding:11px;border-radius:8px;border:1px solid #333;background:#0f101a;color:#fff;margin:5px 0}</style></head><body>
<div id="log" style="max-width:340px;margin:40px auto"><div class="box" style="border-color:#e2136e"><h3 style="text-align:center;color:#e2136e">🔐 ADMIN LOGIN</h3><input id="p" placeholder="Password" type="password"><button onclick="if(document.getElementById('p').value==='99737'){document.getElementById('log').style.display='none';document.getElementById('pan').style.display='block';start()}else alert('Pass: 99737')" style="background:#e2136e;color:#fff;padding:11px;border:none;border-radius:8px;width:100%;font-weight:900">LOGIN</button><p style="font-size:10px;color:#666;text-align:center;margin-top:6px">Pass: 99737</p></div></div>
<div id="pan" style="display:none"><div class="box"><b style="color:#e2136e">💰 ADMIN PANEL - 01904599737</b><br><small>Game: aviator-demo-oo2b.onrender.com</small><div style="display:flex;gap:6px;margin-top:8px"><div style="background:#0f101a;padding:8px;border-radius:8px;flex:1"><small>Total Dep</small><br><b id="td" style="color:#0f0">0</b></div><div style="background:#0f101a;padding:8px;border-radius:8px;flex:1"><small>Total With</small><br><b id="tw" style="color:#e2136e">0</b></div></div></div>
<div class="box"><b>📥 Deposit Requests (Live)</b><table><thead><tr><th>Time</th><th>Amt</th><th>TrxID</th><th>Action</th></tr></thead><tbody id="dl"><tr><td colspan="4" style="color:#666">Wait for deposit...</td></tr></tbody></table></div>
<div class="box"><b>📤 Withdraw Requests (Live)</b><table><thead><tr><th>Time</th><th>Num</th><th>Amt</th><th>Action</th></tr></thead><tbody id="wl"><tr><td colspan="4" style="color:#666">Wait for withdraw...</td></tr></tbody></table></div></div>
<script>let d=[],w=[],td=0,tw=0;function start(){let s=io();s.on('deposit_request',x=>{d.unshift({t:new Date().toLocaleTimeString(),a:x.amt,trx:x.trx});td+=parseFloat(x.amt);r()});s.on('withdraw_request',x=>{w.unshift({t:new Date().toLocaleTimeString(),n:x.num,a:x.amt});tw+=parseFloat(x.amt);r()})}function r(){if(d.length)document.getElementById('dl').innerHTML=d.map(y=>`<tr><td>${y.t}</td><td>${y.a}</td><td>${y.trx}</td><td><button onclick="this.innerText='OK'" style="background:#0f0;border:none;padding:4px 8px;border-radius:4px">Approve</button></td></tr>`).join('');if(w.length)document.getElementById('wl').innerHTML=w.map(y=>`<tr><td>${y.t}</td><td>${y.n}</td><td>${y.a}</td><td><button onclick="alert('Send ${y.a} BDT to ${y.n}')" style="background:#0f0;border:none;padding:4px 8px;border-radius:4px">Pay</button></td></tr>`).join('');document.getElementById('td').innerText=td+' BDT';document.getElementById('tw').innerText=tw+' BDT'}</script></body></html>
